#:import icons kiosk.icons
#:import paint dzieci.games.paint

# Ekrany gier - wspólne dla Kiosku dzieci i HA Intercom. Aplikacja wstawia je do swojego
# ScreenManagera (GamesScreen, TicTacToeScreen, CheckersScreen, ChessScreen, DiceScreen,
# PaintScreen) i ma metodę nav(cel): "games" - siatka gier, "home" - ekran startowy.

#:set GRY_WARM (1.0, 0.84, 0.40, 1)
#:set GRY_TEXT (0.95, 0.95, 0.98, 1)
#:set GRY_TILE (0.20, 0.24, 0.36, 1)
#:set GRY_TILE_DOWN (0.30, 0.36, 0.52, 1)
#:set GRY_ICONS "assets/icons/"
# Material Design Icons: account (1 gracz), account-multiple (2 graczy), lan (sieć)
#:set MODE_GLYPH {1: 0xF0004, 2: 0xF000E, 0: 0xF0317}

# Kafelek gry w siatce: obrazek i nazwa
<GameTile@ButtonBehavior+BoxLayout>:
    image: ""
    title: ""
    target: ""
    orientation: "vertical"
    padding: 18
    spacing: 10
    on_release: app.nav(self.target)
    canvas.before:
        Color:
            rgba: GRY_TILE_DOWN if self.state == "down" else GRY_TILE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [28]
    Image:
        source: (GRY_ICONS + root.image) if root.image else ""
        fit_mode: "contain"
    Label:
        text: root.title
        font_size: "23sp"
        bold: True
        color: GRY_TEXT
        halign: "center"
        valign: "middle"
        text_size: self.width, None
        size_hint_y: None
        height: 64

# Przycisk z napisem w pasku gry (Nowa gra, Wyczyść, Rzuć)
<BarButton@ButtonBehavior+Label>:
    size_hint: None, None
    size: 200, 64
    font_size: "24sp"
    bold: True
    color: GRY_TEXT
    canvas.before:
        Color:
            rgba: GRY_TILE_DOWN if self.state == "down" else GRY_TILE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [32]

# Przycisk Poprzednia / Następna (gra albo piosenka): strzałka z czcionki ikon
<NavButton@ButtonBehavior+AnchorLayout>:
    code: 0
    size_hint: None, None
    size: 76, 64
    canvas.before:
        Color:
            rgba: GRY_TILE_DOWN if self.state == "down" else GRY_TILE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [32]
    Label:
        text: chr(root.code) if root.code else ""
        font_name: icons.FONT_NAME
        font_size: "46sp"
        color: GRY_WARM
        size_hint: None, None
        size: self.texture_size

# Pasek u góry każdej gry: Wstecz (do siatki gier), tytuł, przyciski gry, a na drugim końcu
# Poprzednia i Następna gra (klasa GameBar w dzieci/games/host.py dokłada je na końcu)
<GameBar>:
    size_hint_y: None
    height: 84
    padding: [16, 10]
    spacing: 12
    CloseButton:
        on_release: app.nav("games")
    Label:
        text: root.title
        font_size: "32sp"
        bold: True
        color: GRY_WARM
        halign: "center"
        valign: "middle"
        text_size: self.size
        shorten: True

# Wybór trybu: 1 gracz (z komputerem), 2 graczy (jeden tablet), sieć przez Home Assistant
# (link "ha") albo bezpośrednio między tabletami, bez HA (link "direct", ikona globusa)
<ModeButton@ButtonBehavior+AnchorLayout>:
    game: None
    players: 1
    link: "ha"
    active: False       # ustawiane przy użyciu: active: <gra>.players == <tryb> ...
    choose_side: False
    size_hint: None, None
    size: 80, 64
    on_release: if self.game: app.activate_game_mode(self.game, self.players, self.link, self.choose_side)
    canvas.before:
        Color:
            rgba: GRY_WARM if self.active else GRY_TILE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [32]
    Label:
        text: chr(0xF059F if root.link == "direct" else MODE_GLYPH[root.players])
        font_name: icons.FONT_NAME
        font_size: "40sp"
        color: (0.10, 0.10, 0.12, 1) if root.active else GRY_TEXT

# Napis pod planszą z kółkiem koloru strony zamiast słowa "białe"/"czarne" (szachy, warcaby):
# białe albo czarne kółko z delikatną białą obwódką; board.dot - strona (-1 bez kółka)
<DotStatus>:
    size_hint_y: None
    height: 108 if root.show_color else 70
    BoxLayout:
        orientation: "vertical"
        size_hint: None, None
        width: max(turn.width, side.width)
        height: turn.height + side.height
        BoxLayout:
            id: turn
            size_hint: None, None
            width: lbl.width + dot.width + self.spacing
            height: 70
            spacing: 14
            Label:
                id: lbl
                text: root.turn_text
                font_size: "32sp"
                bold: True
                color: GRY_TEXT
                size_hint_x: None
                width: self.texture_size[0]
            Widget:
                id: dot
                size_hint_x: None
                width: 40 if root.dot >= 0 else 0
                opacity: 1 if root.dot >= 0 else 0
                canvas:
                    Color:
                        rgba: 1, 1, 1, 0.9
                    Ellipse:
                        pos: self.center_x - 19, self.center_y - 19
                        size: 38, 38
                    Color:
                        rgba: (0.97, 0.96, 0.92, 1) if root.dot == 0 else (0.12, 0.12, 0.14, 1)
                    Ellipse:
                        pos: self.center_x - 16, self.center_y - 16
                        size: 32, 32
        Label:
            id: side
            text: root.color_text
            font_size: "24sp"
            bold: True
            color: GRY_TEXT
            size_hint: None, None
            size: self.texture_size[0], 38 if root.show_color else 0
# Napis pod planszą: czyj ruch, kto wygrał
<GameStatus@Label>:
    font_size: "32sp"
    bold: True
    color: GRY_TEXT
    size_hint_y: None
    height: 70

# Kolor w palecie Paint (zaznaczony ma obwódkę) - klasa w dzieci/games/paint.py
<Swatch>:
    size_hint: None, None
    size: 64, 64
    canvas:
        Color:
            rgba: GRY_WARM if (self.paint and self.paint.tool == "pen" and list(self.paint.color) == list(self.rgba)) else (0, 0, 0, 0)
        Ellipse:
            pos: self.x, self.y
            size: self.size
        Color:
            rgba: self.rgba
        Ellipse:
            pos: self.x + 6, self.y + 6
            size: self.width - 12, self.height - 12

# Grubość pędzla (kropka o danej wielkości)
<BrushButton>:
    size_hint: None, None
    size: 64, 64
    canvas:
        Color:
            rgba: GRY_TILE_DOWN if (self.paint and self.paint.brush == self.brush) else GRY_TILE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [18]
        Color:
            rgba: GRY_TEXT
        Ellipse:
            pos: self.center_x - self.brush, self.center_y - self.brush
            size: self.brush * 2, self.brush * 2

# --- ekrany ----------------------------------------------------------------------------------
<GamesScreen@Screen>:
    name: "games"
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            size_hint_y: None
            height: 84
            padding: [16, 10]
            spacing: 16
            CloseButton:
                on_release: app.nav("home")
            Label:
                text: "Gry"
                font_size: "32sp"
                bold: True
                color: GRY_WARM
        GridLayout:
            cols: 6
            padding: [30, 16, 30, 30]
            spacing: 22
            GameTile:
                image: "gra_kolko.png"
                title: "Kółko i krzyżyk"
                target: "tictactoe"
            GameTile:
                image: "gra_warcaby.png"
                title: "Warcaby"
                target: "checkers"
            GameTile:
                image: "gra_szachy.png"
                title: "Szachy"
                target: "chess"
            GameTile:
                image: "gra_paint.png"
                title: "Rysowanie"
                target: "paint"
            GameTile:
                image: "gra_kostka.png"
                title: "Rzut kostką"
                target: "dice"
            GameTile:
                image: "gra_kropki.png"
                title: "Kropki"
                target: "dots"
            GameTile:
                image: "gra_statki.png"
                title: "Statki"
                target: "ships"
            GameTile:
                image: "gra_pkropki.png"
                title: "Polskie kropki"
                target: "pdots"
            GameTile:
                image: "gra_tetris.png"
                title: "Tetris"
                target: "tetris"
            GameTile:
                image: "gra_waz.png"
                title: "Wąż"
                target: "snake"
            GameTile:
                image: "gra_pilkarzyki.png"
                title: "Piłkarzyki"
                target: "football"

<TicTacToeScreen@Screen>:
    name: "tictactoe"
    BoxLayout:
        orientation: "vertical"
        GameBar:
            title: "Kółko i krzyżyk"
            ModeButton:
                game: ttt
                players: 2
                active: ttt.players == 2
            ModeButton:
                game: ttt
                players: 0
                active: ttt.players == 0 and ttt.link == "ha"
            ModeButton:
                game: ttt
                players: 0
                link: "direct"
                active: ttt.players == 0 and ttt.link == "direct"
            BarButton:
                text: "Nowa gra"
                on_release: ttt.restart()
        TicTacToe:
            id: ttt
        GameStatus:
            text: ttt.status

<CheckersScreen@Screen>:
    name: "checkers"
    BoxLayout:
        orientation: "vertical"
        GameBar:
            title: "Warcaby"
            ModeButton:
                game: checkers
                players: 1
                active: checkers.players == 1
            ModeButton:
                game: checkers
                players: 2
                active: checkers.players == 2
            ModeButton:
                game: checkers
                players: 0
                choose_side: True
                active: checkers.players == 0 and checkers.link == "ha"
            ModeButton:
                game: checkers
                players: 0
                link: "direct"
                choose_side: True
                active: checkers.players == 0 and checkers.link == "direct"
            BarButton:
                text: "Nowa gra"
                on_release: checkers.restart()
        Checkers:
            id: checkers
        DotStatus:
            board: checkers

<ChessScreen@Screen>:
    name: "chess"
    BoxLayout:
        orientation: "vertical"
        GameBar:
            title: "Szachy"
            ModeButton:
                game: chess
                players: 1
                active: chess.players == 1
            ModeButton:
                game: chess
                players: 2
                active: chess.players == 2
            ModeButton:
                game: chess
                players: 0
                choose_side: True
                active: chess.players == 0 and chess.link == "ha"
            ModeButton:
                game: chess
                players: 0
                link: "direct"
                choose_side: True
                active: chess.players == 0 and chess.link == "direct"
            BarButton:
                text: "Nowa gra"
                on_release: chess.restart()
        Chess:
            id: chess
        DotStatus:
            board: chess

<DiceScreen@Screen>:
    name: "dice"
    BoxLayout:
        orientation: "vertical"
        GameBar:
            title: "Rzut kostką"
        Dice:
            id: dice
        GameStatus:
            text: dice.status
        AnchorLayout:
            size_hint_y: None
            height: 120
            BarButton:
                text: "Rzuć"
                size: 320, 96
                font_size: "40sp"
                disabled: dice.rolling
                opacity: 0.5 if dice.rolling else 1
                on_release: dice.roll()

<PaintScreen@Screen>:
    name: "paint"
    BoxLayout:
        orientation: "vertical"
        GameBar:
            title: "Rysowanie"
            BarButton:
                text: "Wyczyść"
                on_release: canvas_paint.clear()
        StencilView:
            PaintCanvas:
                id: canvas_paint
                pos: self.parent.pos
                size: self.parent.size
        BoxLayout:
            size_hint_y: None
            height: 84
            padding: [16, 10]
            spacing: 10
            Swatch:
                rgba: paint.COLORS[0]
                paint: canvas_paint
            Swatch:
                rgba: paint.COLORS[1]
                paint: canvas_paint
            Swatch:
                rgba: paint.COLORS[2]
                paint: canvas_paint
            Swatch:
                rgba: paint.COLORS[3]
                paint: canvas_paint
            Swatch:
                rgba: paint.COLORS[4]
                paint: canvas_paint
            Swatch:
                rgba: paint.COLORS[5]
                paint: canvas_paint
            Swatch:
                rgba: paint.COLORS[6]
                paint: canvas_paint
            Swatch:
                rgba: paint.COLORS[7]
                paint: canvas_paint
            Swatch:
                rgba: paint.COLORS[8]
                paint: canvas_paint
            Widget:
            BrushButton:
                brush: paint.SIZES[0]
                paint: canvas_paint
            BrushButton:
                brush: paint.SIZES[1]
                paint: canvas_paint
            BrushButton:
                brush: paint.SIZES[2]
                paint: canvas_paint
            BarButton:
                text: "Gumka"
                size: 150, 64
                color: (0.10, 0.10, 0.12, 1) if canvas_paint.tool == "eraser" else GRY_TEXT
                on_release: canvas_paint.tool = "eraser"
                canvas.before:
                    Color:
                        rgba: GRY_WARM if canvas_paint.tool == "eraser" else (0, 0, 0, 0)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [32]

<DotsScreen@Screen>:
    name: "dots"
    BoxLayout:
        orientation: "vertical"
        GameBar:
            title: "Kropki"
            ModeButton:
                game: dots
                players: 1
                active: dots.players == 1
            ModeButton:
                game: dots
                players: 2
                active: dots.players == 2
            ModeButton:
                game: dots
                players: 0
                active: dots.players == 0 and dots.link == "ha"
            ModeButton:
                game: dots
                players: 0
                link: "direct"
                active: dots.players == 0 and dots.link == "direct"
            BarButton:
                text: "Nowa gra"
                on_release: dots.restart()
        Dots:
            id: dots
        GameStatus:
            text: dots.status

# Statki - tylko przez sieć: wejście na ekran wysyła zaproszenie
<ShipsScreen@Screen>:
    name: "ships"
    on_enter: ships.enter_later()
    BoxLayout:
        orientation: "vertical"
        GameBar:
            title: "Statki"
            ModeButton:
                game: ships
                players: 1
                active: ships.players == 1
            ModeButton:
                game: ships
                players: 0
                active: ships.players == 0 and ships.link == "ha"
            ModeButton:
                game: ships
                players: 0
                link: "direct"
                active: ships.players == 0 and ships.link == "direct"
            BarButton:
                text: "Losuj flotę"
                size: 160, 64
                disabled: ships.started
                opacity: 0.4 if ships.started else 1
                on_release: ships.shuffle()
            BarButton:
                text: "Nowa gra"
                size: 150, 64
                on_release: ships.restart()
        Battleship:
            id: ships
        GameStatus:
            text: ships.status

# Okrągły przycisk sterowania w grach zręcznościowych (znak z czcionki ikon MDI)
<PadButton@ButtonBehavior+AnchorLayout>:
    code: 0
    size_hint: None, None
    size: 118, 118
    canvas.before:
        Color:
            rgba: GRY_TILE_DOWN if self.state == "down" else GRY_TILE
        Ellipse:
            pos: self.pos
            size: self.size
    Label:
        text: chr(root.code) if root.code else ""
        font_name: icons.FONT_NAME
        font_size: "64sp"
        color: GRY_WARM
        size_hint: None, None
        size: self.texture_size

<PadGap@Widget>:
    size_hint: None, None
    size: 118, 118

<PolishDotsScreen@Screen>:
    name: "pdots"
    BoxLayout:
        orientation: "vertical"
        GameBar:
            title: "Polskie kropki"
            ModeButton:
                game: pdots
                players: 1
                active: pdots.players == 1
            ModeButton:
                game: pdots
                players: 2
                active: pdots.players == 2
            ModeButton:
                game: pdots
                players: 0
                active: pdots.players == 0 and pdots.link == "ha"
            ModeButton:
                game: pdots
                players: 0
                link: "direct"
                active: pdots.players == 0 and pdots.link == "direct"
            BarButton:
                text: "Zakończ"
                size: 150, 64
                on_release: pdots.finish_button()
            BarButton:
                text: "Nowa gra"
                size: 150, 64
                on_release: pdots.restart()
        PolishDots:
            id: pdots
        GameStatus:
            text: pdots.status

# Material Design Icons: rotate-right, arrow-collapse-down, chevron-left/right/up/down
<TetrisScreen@Screen>:
    name: "tetris"
    on_leave: tetris.pause()
    BoxLayout:
        orientation: "vertical"
        GameBar:
            title: "Tetris"
            BarButton:
                text: "Graj" if (tetris.paused or tetris.over) else "Pauza"
                on_release: tetris.toggle_pause()
            BarButton:
                text: "Nowa gra"
                on_release: tetris.new_game()
        BoxLayout:
            Tetris:
                id: tetris
            AnchorLayout:
                size_hint_x: None
                width: 320
                GridLayout:
                    cols: 2
                    spacing: 24
                    size_hint: None, None
                    size: 260, 400
                    PadButton:
                        code: 0xF0467
                        on_press: tetris.action("rotate")
                    PadButton:
                        code: 0xF0792
                        on_press: tetris.action("drop")
                    PadButton:
                        code: 0xF0141
                        on_press: tetris.action("left")
                    PadButton:
                        code: 0xF0142
                        on_press: tetris.action("right")
                    PadButton:
                        code: 0xF0140
                        on_press: tetris.action("down")
                    PadGap:
        GameStatus:
            text: tetris.status

<SnakeScreen@Screen>:
    name: "snake"
    on_leave: snake.pause()
    BoxLayout:
        orientation: "vertical"
        GameBar:
            title: "Wąż"
            BarButton:
                text: "Graj" if (snake.paused or snake.over) else "Pauza"
                on_release: snake.toggle_pause()
            BarButton:
                text: "Nowa gra"
                on_release: snake.new_game()
        BoxLayout:
            padding: [10, 0, 0, 0]
            Snake:
                id: snake
            AnchorLayout:
                size_hint_x: None
                width: 400
                GridLayout:
                    cols: 3
                    spacing: 8
                    size_hint: None, None
                    size: 370, 370
                    PadGap:
                    PadButton:
                        code: 0xF0143
                        on_press: snake.turn("up")
                    PadGap:
                    PadButton:
                        code: 0xF0141
                        on_press: snake.turn("left")
                    PadGap:
                    PadButton:
                        code: 0xF0142
                        on_press: snake.turn("right")
                    PadGap:
                    PadButton:
                        code: 0xF0140
                        on_press: snake.turn("down")
                    PadGap:
        GameStatus:
            text: snake.status

<FootballScreen@Screen>:
    name: "football"
    BoxLayout:
        orientation: "vertical"
        GameBar:
            title: "Piłkarzyki"
            ModeButton:
                game: football
                players: 1
                active: football.players == 1
            ModeButton:
                game: football
                players: 2
                active: football.players == 2
            ModeButton:
                game: football
                players: 0
                active: football.players == 0 and football.link == "ha"
            ModeButton:
                game: football
                players: 0
                link: "direct"
                active: football.players == 0 and football.link == "direct"
            BarButton:
                text: "Nowa gra"
                size: 170, 64
                on_release: football.restart()
        Football:
            id: football
        GameStatus:
            text: football.status
