#:import icons kiosk.icons

# Kolory ekranu dzieci
#:set RAIL_BG (0.16, 0.19, 0.29, 1)
#:set WARM (1.0, 0.84, 0.40, 1)
#:set TEXT (0.95, 0.95, 0.98, 1)

# Pozycja menu z ikoną (dom, słuchawka, gry) - target: akcja w DzieciApp.nav;
# code - znak z czcionki ikon, gdy ikony nie ma w słowniku kiosku
<RailButton@ButtonBehavior+AnchorLayout>:
    icon: ""
    code: 0
    target: ""
    size_hint_y: None
    height: 84
    on_release: app.nav(self.target)
    canvas.before:
        Color:
            rgba: (1, 1, 1, 0.20) if self.state == "down" else (1, 1, 1, 0.07)
        RoundedRectangle:
            pos: self.center_x - 40, self.center_y - 40
            size: 80, 80
            radius: [24]
    Label:
        text: chr(root.code) if root.code else icons.glyph(root.icon)
        font_name: icons.FONT_NAME
        font_size: "46sp"
        color: WARM
        size_hint: None, None
        size: self.texture_size

<RailText@Label>:
    size_hint_y: None
    height: 58
    bold: True
    color: TEXT

# Podpis pod zegarem (bieżąca czynność, dzień tygodnia, pora roku)
<Caption@Label>:
    font_size: "34sp"
    bold: True
    color: WARM
    size_hint_y: None
    height: 60

<HomeControlButton@ButtonBehavior+AnchorLayout>:
    code: 0
    size_hint: None, None
    size: 54, 54
    canvas.before:
        Color:
            rgba: (0.30, 0.36, 0.52, 1) if self.state == "down" else (0.20, 0.24, 0.36, 1)
        Ellipse:
            pos: self.pos
            size: self.size
    Label:
        text: chr(root.code) if root.code else ""
        font_name: icons.FONT_NAME
        font_size: "34sp"
        color: WARM
        size_hint: None, None
        size: self.texture_size

<ReadClockButton@ButtonBehavior+BoxLayout>:
    orientation: "horizontal"
    size_hint: None, None
    size: 156, 56
    padding: [10, 4]
    spacing: 8
    canvas.before:
        Color:
            rgba: (0.30, 0.36, 0.52, 1) if self.state == "down" else (0.20, 0.24, 0.36, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [20]
    Label:
        text: chr(0xF057E)
        font_name: icons.FONT_NAME
        font_size: "30sp"
        color: WARM
        size_hint_x: None
        width: 34
    Label:
        text: "Sprawdź"
        font_size: "20sp"
        bold: True
        color: TEXT

BoxLayout:
    orientation: "horizontal"

    ScreenManager:
        id: sm
        Screen:
            name: "start"
            BoxLayout:
                padding: [16, 0]
                spacing: 18
                BoxLayout:
                    orientation: "vertical"
                    spacing: 14
                    ReadClockButton:
                        pos_hint: {"center_x": 0.5}
                        on_release: app.read_clock()
                    Widget:
                    DayClock:
                        id: day
                        size_hint_y: None
                        height: self.width
                        # dotknięcie tarczy powtarza komunikat bieżącej czynności
                        on_touch_down: app.announcer.say() if self.collide_point(*args[1].pos) else None
                    Caption:
                        text: day.caption
                    BoxLayout:
                        size_hint_y: None
                        height: 62
                        spacing: 4
                        HomeControlButton:
                            code: 0xF040A if (app.music.paused or not app.music.playing) else 0xF03E4
                            on_release: app.music.toggle()
                        HomeControlButton:
                            code: 0xF04DB
                            on_release: app.music.stop()
                        Label:
                            text: chr(0xF057E)
                            font_name: icons.FONT_NAME
                            font_size: "26sp"
                            color: WARM
                            size_hint_x: None
                            width: 28
                        Slider:
                            min: 0
                            max: 100
                            value: app.volume_value
                            on_value: app.set_music_volume(self.value)
                        HomeControlButton:
                            code: 0xF0379
                            on_release: app.screensaver.blank()
                    Widget:
                BoxLayout:
                    orientation: "vertical"
                    spacing: 14
                    size_hint_x: 1.12
                    Widget:
                    Label:
                        text: app.clock_time_text
                        font_size: "34sp"
                        bold: True
                        color: TEXT
                        size_hint_y: None
                        height: 56
                    AnalogClock:
                        id: analog
                        size_hint_y: None
                        height: self.width
                    Caption:
                        text: analog.caption
                        color: TEXT
                    Widget:
                BoxLayout:
                    orientation: "vertical"
                    spacing: 14
                    Widget:
                    Label:
                        text: app.clock_date_text
                        font_size: "28sp"
                        bold: True
                        color: TEXT
                        size_hint_y: None
                        height: 56
                    SeasonClock:
                        id: season
                        size_hint_y: None
                        height: self.width
                    Caption:
                        text: season.caption
                    Widget:
            # imię dziecka na dole pod zegarami (tablet.json, osobne na każdym tablecie)
            Label:
                text: app.child_name
                font_size: "52sp"
                bold: True
                color: WARM
                size_hint: 1, None
                height: 90
                pos_hint: {"x": 0, "y": 0.03}
        # gry - wspólne ekrany z dzieci/games/gry.kv
        GamesScreen:
        TicTacToeScreen:
        CheckersScreen:
        ChessScreen:
        DiceScreen:
        PaintScreen:
        DotsScreen:
        ShipsScreen:
        PolishDotsScreen:
        TetrisScreen:
        SnakeScreen:
        FootballScreen:
        # muzyka - dzieci/music/muzyka.kv
        MusicScreen:
        # kolorowanki - dzieci/coloring/kolorowanki.kv
        ColoringScreen:
        ColorPageScreen:
        # aparat - dzieci/camera/aparat.kv
        CameraScreen:
        PhotosScreen:

    # Menu po prawej: dom, godzina, data, słuchawka, gry
    BoxLayout:
        id: rail
        orientation: "vertical"
        size_hint_x: None
        width: 128 if app.section == "home" else 0
        opacity: 1 if app.section == "home" else 0
        disabled: app.section != "home"
        padding: [0, 8]
        spacing: 4
        canvas.before:
            Color:
                rgba: RAIL_BG
            Rectangle:
                pos: self.pos
                size: self.size
        RailButton:
            icon: "home"
            target: "home"
        RailText:
            text: app.time_text
            font_size: "40sp"
        RailText:
            text: app.date_text
            font_size: "34sp"
            color: WARM
        RailButton:
            icon: "phone"
            target: "voice"
        RailButton:
            # gamepad-variant z Material Design Icons
            code: 0xF0297
            target: "games"
        RailButton:
            # music z Material Design Icons - piosenki dla dzieci
            code: 0xF075A
            target: "music"
        RailButton:
            # palette z Material Design Icons - kolorowanki
            code: 0xF03D8
            target: "coloring"
        RailButton:
            # camera z Material Design Icons - aparat (zdjęcia na kartę SD)
            code: 0xF0100
            target: "camera"
        Widget:
        RailButton:
            # exit-run z Material Design Icons - wyjście z aplikacji (3 razy „Tak”)
            code: 0xF0425
            target: "exit"
        Label:
            text: ("v" + app.app_version) if app.app_version else ""
            font_size: "13sp"
            color: TEXT
            size_hint_y: None
            height: 16
            text_size: self.size
            halign: "center"
            valign: "middle"
        Label:
            text: app.battery_text
            font_size: "16sp"
            color: WARM
            size_hint_y: None
            height: 20
            text_size: self.size
            halign: "center"
            valign: "middle"
